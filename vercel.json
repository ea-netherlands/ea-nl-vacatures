{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/ingest?kind=ats&kind=ea-board",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/ingest?kind=crawl&concurrency=2",
      "schedule": "20 5 * * *"
    },
    {
      "path": "/api/cron/ingest?source=academictransfer&concurrency=1",
      "schedule": "40 5 * * *"
    },
    {
      "path": "/api/cron/classify",
      "schedule": "30 6 * * *"
    },
    {
      "path": "/api/cron/promote",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/expire",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/translate",
      "schedule": "20 */3 * * *"
    },
    {
      "path": "/api/cron/linkcheck",
      "schedule": "0 9 * * 1"
    },
    {
      "path": "/api/cron/notify",
      "schedule": "0 11 * * 1"
    },
    {
      "path": "/api/cron/ingest?source=80000hours&source=probablygood&discover=1",
      "schedule": "0 10 * * 1"
    }
  ],
  "functions": {
    "src/app/api/cron/[job]/route.ts": {
      "maxDuration": 300
    }
  }
}
