# ---------------------------------------------------------------------------
# EA Nederland job board — environment
#
# Copy to .env.local for development. Nothing here is required to get the
# front end running: with no DATABASE_URL the pipeline uses a local PGlite
# database, and with no Sanity project the board renders its empty states.
# ---------------------------------------------------------------------------

# --- Postgres (spec §6.2) --------------------------------------------------
# Neon or Supabase free tier is ample. Leave unset locally and the pipeline
# uses PGlite in ./.pgdata instead — same SQL, no server to install.
#
# REQUIRED IN PRODUCTION. Unset on Vercel, the pipeline silently falls back to
# PGlite on an ephemeral filesystem that is wiped between invocations: every run
# starts from an empty database, so dedup and closure detection both break and
# nothing ever accumulates. This is the single easiest way to deploy something
# that looks healthy and does nothing.
# DATABASE_URL=postgres://user:pass@host/db?sslmode=require
# PGLITE_DIR=.pgdata
# PGPOOL_MAX=5

# --- Sanity (spec §6.2a) ---------------------------------------------------
# A NEW project, owned by EA NL from the first commit — not the main site's.
# Create at https://sanity.io/manage (M0).
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01
# Editor-rights token. Needed only by the promotion and expiry jobs.
SANITY_API_WRITE_TOKEN=

# --- The classifier (spec §12: needs an owner) ------------------------------
# Resolved automatically from ANTHROPIC_API_KEY, ANTHROPIC_AUTH_TOKEN, or an
# `ant auth login` profile.
ANTHROPIC_API_KEY=
# The model split is deliberate (§8.4): a small fast model over thousands of
# listings a week, the strongest model for the much smaller set of editorial
# notes, and the strongest model for prose regardless of the economics.
# TRIAGE_MODEL=claude-haiku-4-5
# DRAFTING_MODEL=claude-opus-5
# PROSE_MODEL=claude-opus-5

# --- Gates -----------------------------------------------------------------
# Set high enough that the earning-to-give section stays small (§5.3).
# E2G_SALARY_FLOOR=90000

# --- CSO Vacature API (spec §7.3) ------------------------------------------
# M0 lead-time item, no self-service signup: email
# helpdesk@werkenvoornederland.nl or call +31 70 7000510. The wvn-sitemap
# source covers the same ground meanwhile, so this is not a blocker.
CSO_API_USERNAME=
CSO_API_PASSWORD=

# --- Deployment ------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://vacatures.effectiefaltruisme.nl
# Vercel sends this as a bearer token on cron invocations, and the route checks
# it before doing any work. Required for the crons to run at all: on Vercel the
# endpoints fail closed, so if this is unset every scheduled run returns 401 and
# the board quietly never updates. Generate one with `openssl rand -hex 32`.
CRON_SECRET=
# Identifies the crawler to every source, with contact details (§10).
# CRAWLER_USER_AGENT=EANetherlandsJobBoard/1.0 (+https://effectiefaltruisme.nl/vacatures; jobs@effectiefaltruisme.nl)

# --- Feedback digest -------------------------------------------------------
# The board's feedback form writes a `suggestion` document and, without this,
# notifies nobody — submissions wait in the Studio for someone to remember to
# look. /api/cron/notify mails a digest weekly (Mondays 11:00) via Resend.
#
# Unset, the cron is a no-op that logs how many suggestions are waiting rather
# than failing, so the deployment stays green and the gap is visible in the log.
# Create a key at resend.com and verify the sending domain.
RESEND_API_KEY=
# Overridable so a test run can be sent somewhere other than the shared inbox.
# FEEDBACK_DIGEST_TO=info@effectiefaltruisme.nl
# Must be on a domain verified in Resend.
# FEEDBACK_DIGEST_FROM=Vacaturebord <vacatures@effectiefaltruisme.nl>
