# ---------------------------------------------------------------------------
# EA Nederland job board — environment
#
# Copy to .env.local for development. Nothing here is required to get the
# front end running: with no DATABASE_URL the pipeline uses a local PGlite
# database, and with no Sanity project the board renders its empty states.
# ---------------------------------------------------------------------------

# --- Postgres (spec §6.2) --------------------------------------------------
# Neon or Supabase free tier is ample. Leave unset locally and the pipeline
# uses PGlite in ./.pgdata instead — same SQL, no server to install.
# DATABASE_URL=postgres://user:pass@host/db?sslmode=require
# PGLITE_DIR=.pgdata
# PGPOOL_MAX=5

# --- Sanity (spec §6.2a) ---------------------------------------------------
# A NEW project, owned by EA NL from the first commit — not the main site's.
# Create at https://sanity.io/manage (M0).
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01
# Editor-rights token. Needed only by the promotion and expiry jobs.
SANITY_API_WRITE_TOKEN=

# --- The classifier (spec §12: needs an owner) ------------------------------
# Resolved automatically from ANTHROPIC_API_KEY, ANTHROPIC_AUTH_TOKEN, or an
# `ant auth login` profile.
ANTHROPIC_API_KEY=
# The model split is deliberate (§8.4): a small fast model over thousands of
# listings a week, the strongest model for the much smaller set of editorial
# notes, and the strongest model for prose regardless of the economics.
# TRIAGE_MODEL=claude-haiku-4-5
# DRAFTING_MODEL=claude-opus-5
# PROSE_MODEL=claude-opus-5

# --- Gates -----------------------------------------------------------------
# Set high enough that the earning-to-give section stays small (§5.3).
# E2G_SALARY_FLOOR=90000

# --- CSO Vacature API (spec §7.3) ------------------------------------------
# M0 lead-time item, no self-service signup: email
# helpdesk@werkenvoornederland.nl or call +31 70 7000510. The wvn-sitemap
# source covers the same ground meanwhile, so this is not a blocker.
CSO_API_USERNAME=
CSO_API_PASSWORD=

# --- Deployment ------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://vacatures.effectiefaltruisme.nl
# Vercel sends this as a bearer token on cron invocations. Without it the
# pipeline endpoints are public, which would burn the classifier budget and
# Probably Good's search quota.
CRON_SECRET=
# Identifies the crawler to every source, with contact details (§10).
# CRAWLER_USER_AGENT=EANetherlandsJobBoard/1.0 (+https://effectiefaltruisme.nl/vacatures; jobs@effectiefaltruisme.nl)
